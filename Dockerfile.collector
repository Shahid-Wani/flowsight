# FlowSight Collector Dockerfile
FROM python:3.11-slim

WORKDIR /app

# pyproject declares readme = "README.md" - it must be present before install
COPY pyproject.toml README.md ./
COPY flowsight/ ./flowsight/

# Sane default config; every value can be overridden via SECTION__FIELD env vars
COPY config.example.yaml ./config.yaml

RUN pip install --no-cache-dir .

EXPOSE 2055/udp

CMD ["flowsight-collector"]
